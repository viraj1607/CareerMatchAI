# Local default is 5 MiB. For Vercel staging set 4000000 (below its body cap).
CAREERMATCH_RESUME_MAX_BYTES=5242880
CAREERMATCH_PDF_MAX_PAGES=80
CAREERMATCH_PDF_MAX_TEXT_CHARS=200000
CAREERMATCH_PDF_TIMEOUT_MS=10000
CAREERMATCH_PARSE_MAX_CONCURRENCY=4
CAREERMATCH_EXPORT_MAX_CONCURRENCY=4
CAREERMATCH_GEMINI_ANALYZE_LIMIT=5
CAREERMATCH_GEMINI_SUGGEST_LIMIT=5
GEMINI_API_KEY=your_server_side_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/anon keys are public by design; never use privileged credentials here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional legacy key name for older Supabase projects:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Auth redirects use the browser/request origin. No app-URL variable is consumed.
# Do not upload local QA credential files as deployment environment variables.

# Disabled by default. Set exactly "true" only on a separate public portfolio
# deployment. It exposes /portfolio only, redirects all application pages there,
# and returns 404 for every /api route before Supabase or provider code can run.
# Leave unset or false for local development and the protected staging deployment.
CAREERMATCH_PORTFOLIO_DEMO=false
